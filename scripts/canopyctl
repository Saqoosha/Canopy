#!/usr/bin/env python3
"""Send one request to a local Canopy daemon control socket.

See docs/CONTROL_PROTOCOL.md. Stdlib only.
"""

import argparse
import json
import os
import socket
import sys
import time
import uuid
from pathlib import Path

DEFAULT_SOCK = (
    Path.home()
    / "Library/Application Support/Canopy/daemon-sh.saqoo.Canopy.sock"
)
# wait_turn polls for 60s; the read has to outlast that. A listen also hears a
# heartbeat every 30s, so --follow treats 90s of silence as a dead connection.
READ_TIMEOUT = 90.0
# --follow: each listen's own timeout, and the reconnect backoff ceiling.
FOLLOW_LISTEN_TIMEOUT = 300
FOLLOW_MAX_BACKOFF = 30.0
LISTEN_EVENTS = {
    "turn_done",
    "permission",
    "asking",
    "addressed",
    "session_opened",
    "session_closed",
}


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--socket",
        default=os.environ.get("CANOPY_CONTROL_SOCK", str(DEFAULT_SOCK)),
        help="control socket path (or CANOPY_CONTROL_SOCK)",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    list_p = sub.add_parser("list", help="list_sessions")
    list_p.add_argument(
        "--scope",
        choices=("open", "recent"),
        help="recent: closed sessions; each row's resumeId is what resume takes",
    )
    list_p.add_argument("--query", help="implies --scope recent: title, project, cwd or first prompt")
    list_p.add_argument("--limit", type=int)

    sessions_p = sub.add_parser(
        "sessions",
        help="past sessions, closed ones included (list_sessions scope=recent); "
        "pick a sessionId and pass it to resume",
    )
    sessions_p.add_argument("--project", help="project name or cwd contains this")
    sessions_p.add_argument("--query", help="words in the title, project, cwd or first prompt")
    sessions_p.add_argument("--since", help="active on or after: YYYY-MM-DD, ISO 8601, or Unix seconds")
    sessions_p.add_argument("--until", help="active on or before: YYYY-MM-DD, ISO 8601, or Unix seconds")
    sessions_p.add_argument("--limit", type=int, help="default 50")
    sessions_p.add_argument(
        "--closed-only", action="store_true", help="leave out sessions that are open now"
    )
    sessions_p.add_argument("--table", action="store_true", help="one line per session instead of JSON")

    open_p = sub.add_parser(
        "open", help="open_session (--resume continues a session that is not open)"
    )
    open_p.add_argument("--cwd", help="required unless --resume")
    open_p.add_argument(
        "--resume",
        metavar="SESSION_ID",
        help="continue this session (resumeSessionId); returns its key if already open",
    )
    add_open_flags(open_p)
    open_p.add_argument("--worktree-branch", dest="worktree_branch")

    resume_p = sub.add_parser(
        "resume", help="open_session with resumeSessionId: continue a session"
    )
    resume_p.add_argument("session_id", metavar="SESSION_ID")
    resume_p.add_argument("--cwd", help="must hold the transcript; default: its own")
    add_open_flags(resume_p)

    send_p = sub.add_parser("send", help="send_message")
    add_session_flags(send_p, require=True)
    send_p.add_argument("--text", required=True)

    for name, help_text in (
        ("status", "session_status"),
        ("reply", "latest_reply"),
        ("wait", "wait_turn"),
        ("stop", "stop_session"),
        ("pending", "pending_requests"),
    ):
        sub_p = sub.add_parser(name, help=help_text)
        add_session_flags(sub_p, require=True)
        if name not in ("stop", "pending"):
            sub_p.add_argument("--reply-id", dest="reply_id")

    history_p = sub.add_parser(
        "history", help="history: the last turns, pane and phone ones included"
    )
    add_session_flags(history_p, require=True)
    history_p.add_argument("--limit", type=int, help="turns (default 10, max 50)")

    listen_p = sub.add_parser(
        "listen",
        help="listen: block until an event, print it; exit 0 event, "
        "3 timeout, 4 connection lost, 1 error",
    )
    listen_p.add_argument("--key")
    listen_p.add_argument("--session-id", dest="session_id")
    listen_p.add_argument(
        "--event",
        dest="events",
        action="append",
        choices=sorted(LISTEN_EVENTS),
        help="repeatable; default every event except addressed",
    )
    listen_p.add_argument(
        "--to",
        dest="addressed_to",
        help="only replies addressed to this name (adds --event addressed)",
    )
    listen_p.add_argument("--since", help="cursor from a previous listen")
    listen_p.add_argument(
        "--timeout", type=float, default=300, help="seconds (max 3600)"
    )
    listen_p.add_argument(
        "--follow",
        action="store_true",
        help="keep listening: one JSON line per event, reconnecting with the "
        "same cursor when the daemon goes away; --timeout is ignored",
    )
    listen_p.add_argument(
        "--cursor-file",
        dest="cursor_file",
        help="read the starting cursor from this file (unless --since) and "
        "write each new cursor back to it",
    )

    args = parser.parse_args(argv)
    if args.cmd == "listen" and args.follow:
        return follow(args)
    if args.cmd == "listen" and args.cursor_file and not args.since:
        args.since = read_cursor(args.cursor_file)
    verb, params = build(args)
    read_timeout = READ_TIMEOUT
    if args.cmd == "listen":
        read_timeout = min(args.timeout, 3600) + 30
    try:
        result = transact(args.socket, verb, params, read_timeout)
    except HelloRefused as exc:
        print(f"canopyctl: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"canopyctl: {exc}", file=sys.stderr)
        # A listen loop retries this with its cursor; a daemon restart lands here.
        return 4 if args.cmd == "listen" else 1
    body = result["result"] if isinstance(result.get("result"), dict) else result
    if getattr(args, "table", False) and "error" not in result:
        print_session_table(body.get("sessions", []))
        return 0
    json.dump(result, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    if "error" in result or body.get("ok") is False:
        return 1
    if args.cmd == "wait" and body.get("turnDone") is not True:
        return 1
    if args.cmd == "listen" and args.cursor_file and body.get("cursor"):
        sys.stdout.flush()
        write_cursor(args.cursor_file, body["cursor"])
    if args.cmd == "listen" and body.get("timedOut") is True:
        return 3
    return 0


def follow(args):
    """listen in a loop. Exits 1 on a refused hello or an error response,
    130 on Ctrl-C; never on a timeout or a lost connection."""
    try:
        return follow_loop(args)
    except KeyboardInterrupt:
        return 130


def follow_loop(args):
    cursor = args.since or (read_cursor(args.cursor_file) if args.cursor_file else None)
    backoff = 1.0
    while True:
        args.since = cursor
        args.timeout = FOLLOW_LISTEN_TIMEOUT
        verb, params = build(args)
        try:
            result = transact(args.socket, verb, params, READ_TIMEOUT)
        except HelloRefused as exc:
            print(f"canopyctl: {exc}", file=sys.stderr)
            return 1
        except socket.timeout:
            # A daemon without heartbeats is silent for a whole quiet listen: ask again at once.
            print(f"canopyctl: nothing for {READ_TIMEOUT:.0f}s; listening again", file=sys.stderr)
            backoff = 1.0
            continue
        except (OSError, ValueError) as exc:
            print(f"canopyctl: {exc}; reconnecting in {backoff:.0f}s", file=sys.stderr)
            time.sleep(backoff)
            backoff = min(backoff * 2, FOLLOW_MAX_BACKOFF)
            continue
        backoff = 1.0
        body = result.get("result") if isinstance(result.get("result"), dict) else None
        if "error" in result or body is None:
            json.dump(result, sys.stdout, ensure_ascii=False)
            sys.stdout.write("\n")
            return 1
        if body.get("timedOut") is not True:
            json.dump(result, sys.stdout, ensure_ascii=False)
            sys.stdout.write("\n")
            sys.stdout.flush()
        # Only after the event is out, so a restarted follower never skips one.
        if body.get("cursor"):
            cursor = body["cursor"]
            if args.cursor_file:
                write_cursor(args.cursor_file, cursor)


def read_cursor(path):
    try:
        return Path(path).read_text(encoding="utf-8").strip() or None
    except FileNotFoundError:
        return None


def write_cursor(path, cursor):
    """Replaced whole, so a reader never sees half a cursor."""
    tmp = f"{path}.tmp-{os.getpid()}"
    Path(tmp).write_text(cursor + "\n", encoding="utf-8")
    os.replace(tmp, path)


def as_seconds(value):
    """A number is Unix seconds, which the daemon takes only as a JSON number."""
    try:
        return float(value) if value and "." in value else int(value)
    except (TypeError, ValueError):
        return value


def print_session_table(sessions):
    """started  last active  state  sessionId  project  title — first prompt"""
    import datetime

    def when(seconds):
        if not seconds:
            return "-" * 16
        return datetime.datetime.fromtimestamp(seconds).strftime("%Y-%m-%d %H:%M")

    def plain(text):
        # Titles and prompts are transcript text: no terminal escapes reach the screen.
        return " ".join("".join(c for c in (text or "") if c.isprintable() or c.isspace()).split())

    for row in sessions:
        prompt = plain(row.get("firstPrompt"))
        if len(prompt) > 80:
            prompt = prompt[:79] + "…"
        line = "  ".join(
            [
                when(row.get("startedAt")),
                when(row.get("lastActiveAt")),
                f"{row.get('state', ''):<10}",
                row.get("sessionId") or row.get("resumeId", ""),
                plain(row.get("project")),
                plain(row.get("title")),
            ]
        )
        print(f"{line} — {prompt}" if prompt else line)


class HelloRefused(Exception):
    """The daemon answered hello_error: retrying will not help."""


def add_open_flags(parser):
    parser.add_argument("--model")
    parser.add_argument("--effort")
    parser.add_argument("--permission-mode", dest="permission_mode")
    parser.add_argument("--initial-prompt", dest="initial_prompt")


def add_session_flags(parser, require):
    parser.add_argument("--key")
    parser.add_argument("--session-id", dest="session_id")
    parser.set_defaults(_require_session=require)


def build(args):
    if args.cmd == "list":
        params = {}
        if args.scope == "open" and args.query:
            raise SystemExit("canopyctl: --query works only with --scope recent")
        if args.scope or args.query:
            params["scope"] = args.scope or "recent"
        if args.query:
            params["query"] = args.query
        if args.limit is not None:
            params["limit"] = args.limit
        return "list_sessions", params
    if args.cmd == "sessions":
        params = {"scope": "recent", "includeOpen": not args.closed_only}
        for key, value in (
            ("project", args.project),
            ("query", args.query),
            ("since", as_seconds(args.since)),
            ("until", as_seconds(args.until)),
        ):
            if value:
                params[key] = value
        if args.limit is not None:
            params["limit"] = args.limit
        return "list_sessions", params
    if args.cmd in ("open", "resume"):
        resume = args.session_id if args.cmd == "resume" else args.resume
        if not resume and not args.cwd:
            raise SystemExit("canopyctl: open needs --cwd or --resume")
        params = {}
        optional = {
            "resumeSessionId": resume,
            "cwd": args.cwd,
            "model": args.model,
            "effort": args.effort,
            "permissionMode": args.permission_mode,
            "worktreeBranch": getattr(args, "worktree_branch", None),
            "initialPrompt": args.initial_prompt,
        }
        for key, value in optional.items():
            if value:
                params[key] = value
        return "open_session", params
    params = session_params(args)
    if args.cmd == "history":
        if args.limit is not None:
            params["limit"] = args.limit
        return "history", params
    if args.cmd == "listen":
        if args.events:
            params["events"] = list(args.events)
        if args.addressed_to:
            params["addressedTo"] = args.addressed_to
            if args.events and "addressed" not in args.events:
                params["events"].append("addressed")
        if args.since:
            params["since"] = args.since
        params["timeout"] = args.timeout
        return "listen", params
    if args.cmd == "send":
        params["text"] = args.text
        return "send_message", params
    if args.cmd == "stop":
        return "stop_session", params
    if args.cmd == "pending":
        return "pending_requests", params
    verbs = {"status": "session_status", "reply": "latest_reply", "wait": "wait_turn"}
    if args.reply_id:
        params["replyId"] = args.reply_id
    return verbs[args.cmd], params


def session_params(args):
    params = {}
    if args.key:
        params["key"] = args.key
    if args.session_id:
        params["sessionId"] = args.session_id
    if getattr(args, "_require_session", False) and not params:
        raise SystemExit("canopyctl: pass --key and/or --session-id")
    return params


def transact(path, verb, params, read_timeout=READ_TIMEOUT):
    request_id = uuid.uuid4().hex
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(read_timeout)
    sock.connect(path)
    lines = LineBuffer(sock)
    try:
        send_line(sock, {"type": "hello", "protocolVersion": 1})
        hello = read_typed(lines, {"hello_ok", "hello_error"})
        if hello.get("type") == "hello_error":
            message = hello.get("message") or "daemon refused hello"
            raise HelloRefused(message)
        send_line(
            sock,
            {"type": "request", "id": request_id, "verb": verb, "params": params},
        )
        while True:
            line = lines.read_line()
            if line.get("type") == "response" and line.get("id") == request_id:
                return line
    finally:
        sock.close()


def read_typed(lines, types):
    while True:
        line = lines.read_line()
        if line.get("type") in types:
            return line


class LineBuffer:
    """Keeps bytes past a newline: one recv can end mid-line or span lines."""

    def __init__(self, sock):
        self.sock = sock
        self.buf = b""

    def read_line(self):
        while b"\n" not in self.buf:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise OSError("daemon closed the socket")
            self.buf += chunk
        raw, _, rest = self.buf.partition(b"\n")
        self.buf = rest
        return json.loads(raw.decode("utf-8"))


def send_line(sock, obj):
    sock.sendall((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))


if __name__ == "__main__":
    try:
        code = main(sys.argv[1:])
        sys.stdout.flush()
    except BrokenPipeError:
        # The reader went away. Point stdout at /dev/null so the exit flush cannot fail again.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 1
    sys.exit(code)
